# ==========================================================================
# 复制为 .env 后填写，.env 不要提交到版本库
# cp .env.example .env
# ==========================================================================

# 必填：DeepSeek API Key（在 https://platform.deepseek.com 创建）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ---------------------------- 以下均可省略 ----------------------------

# 服务监听地址与端口
# HOST=0.0.0.0
# PORT=8000

# DeepSeek 端点（默认值即官方文档端点，一般无需修改）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_SEARCH_URL=https://api.deepseek.com/v1/tools/search
# DEEPSEEK_FETCH_URL=https://api.deepseek.com/v1/tools/fetch
# DEEPSEEK_CHAT_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_CHAT_MODEL=deepseek-chat

# 未配置 API Key 时是否生成“演示日报”（0=关闭，1=开启；仅用于预览页面样式）
# DEMO_MODE=0

# 流水线阈值（不填则使用代码内默认值）
# STRICT_RERANK_SCORE=1.5
# STRICT_AUTHORITY=3
# MIN_CANDIDATES=8
# MAX_CANDIDATES=12
# SELECT_MIN_ITEMS=4
# SELECT_MAX_ITEMS=6
# FETCH_MAX_CHARS=8000
